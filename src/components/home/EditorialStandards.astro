---
/**
 * EditorialStandards — "How This Wiki Stays Current" trust strip.
 *
 * Borrowed from competitor playbooks: states the editorial policy (official
 * sourcing, review dates, labeled community findings) right below the
 * Recent Updates list that evidences it. Data-driven via locale JSON
 * `home.editorial`; renders nothing when the data is absent.
 */
import { Icon } from 'astro-icon/components';

interface EditorialPoint {
  icon: string;
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  points?: EditorialPoint[];
}
const { eyebrow, title, points = [] } = Astro.props;
---

{
  (eyebrow || title) && points.length > 0 && (
    <section class="border-t border-border bg-muted/40 py-10">
      <div class="mx-auto w-full max-w-7xl px-4">
        {eyebrow && (
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{eyebrow}</p>
        )}
        {title && <h2 class="mt-1 text-2xl font-bold">{title}</h2>}
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {points.map((point: EditorialPoint) => (
            <div class="flex gap-3">
              <Icon name={point.icon} class="mt-0.5 h-5 w-5 shrink-0 text-nav" />
              <div>
                <h3 class="text-sm font-semibold">{point.title}</h3>
                <p class="mt-1 text-sm text-muted-foreground">{point.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
