---
/**
 * FaqSection — renders the FAQ accordion from locale JSON `home.faq`.
 *
 * Used on the dedicated /faq page (heading as h1) and as a compact homepage
 * section (heading as h2) for search-intent interception with internal links.
 * Pure CSS <details> accordion with a tiny inline script to sync aria-expanded.
 */
import { Icon } from 'astro-icon/components';
import { defaultLocale, type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';

interface FaqItem {
  question: string;
  answer: string;
  /** Optional internal link shown under the answer — funnels search intent to depth pages. */
  link?: { label: string; href: string };
}

interface Props {
  title: string;
  description?: string;
  items: FaqItem[];
  /** Heading level: h1 on the standalone /faq page, h2 when embedded on the homepage. */
  headingLevel?: 'h1' | 'h2';
  /** Locale for localizing item links. */
  locale?: Locale;
}
const { title, description, items = [], headingLevel = 'h1', locale = defaultLocale } = Astro.props;
const Heading = headingLevel;
const headingClass =
  headingLevel === 'h1'
    ? 'text-3xl font-extrabold tracking-tight md:text-4xl'
    : 'text-2xl font-bold';
---

<section class="section border-t border-border">
  <Heading class={headingClass}>{title}</Heading>
  {description && <p class="mt-2 text-muted-foreground">{description}</p>}
  <div class="mt-8 space-y-2" data-faq-group>
    {
      items.map((item: FaqItem) => (
        <details class="group rounded-md border bg-card">
          <summary
            class="flex cursor-pointer list-none items-center justify-between p-4 font-medium"
            aria-expanded="false"
          >
            {item.question}
            <Icon name="lucide:chevron-down" class="h-4 w-4 transition group-open:rotate-180" />
          </summary>
          <div class="px-4 pb-4 text-sm text-muted-foreground">
            {item.answer}
            {item.link && (
              <a
                href={localizePath(item.link.href, locale)}
                class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-nav hover:underline"
              >
                {item.link.label}
                <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
              </a>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<script is:inline>
  // Sync aria-expanded on FAQ summaries when details toggle.
  document.querySelectorAll('[data-faq-group] details').forEach((d) => {
    const sync = () =>
      d.querySelector('summary')?.setAttribute('aria-expanded', d.open ? 'true' : 'false');
    sync();
    d.addEventListener('toggle', sync);
  });
</script>
